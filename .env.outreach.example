# =============================================================
# アウトリーチCLIのメール送信設定（テンプレート）
# -------------------------------------------------------------
# このファイルを .env.outreach という名前でコピーして値を埋めてください。
# .env.outreach は .gitignore 済みです。絶対にコミットしないでください。
# =============================================================

# --- SMTPサーバー ---
# Gmail の場合は変更不要です
OUTREACH_SMTP_HOST=smtp.gmail.com
OUTREACH_SMTP_PORT=465

# --- 認証情報 ---
# Gmail では「アプリパスワード」が必要です（通常のログインパスワードでは送れません）
#   1. Googleアカウントで2段階認証を有効にする
#   2. https://myaccount.google.com/apppasswords でアプリパスワードを発行
#   3. 発行された16桁を OUTREACH_SMTP_PASS に貼る
OUTREACH_SMTP_USER=
OUTREACH_SMTP_PASS=

# --- 差出人の表示 ---
OUTREACH_FROM_NAME=AIツールナビ 編集部
# 未指定なら OUTREACH_SMTP_USER と同じアドレスになります
OUTREACH_FROM_EMAIL=
# 返信先を分けたい場合のみ指定
OUTREACH_REPLY_TO=

# --- 任意 ---
# 送信控えを自分宛にも残したい場合（カンマ区切り）
OUTREACH_BCC=
# 24時間あたりの送信上限（大量送信の歯止め）
OUTREACH_DAILY_LIMIT=20
